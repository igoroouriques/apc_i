algoritmo "funcoesCaractereSimples"

var
   texto: caractere

inicio
   escreva("Digite um texto: ")
   leia(texto)
   
   escreval("")
   escreval("Texto original: ", texto)
   escreval("Primeiros 3 caracteres: ", copia(texto, 1, 3))
   escreval("Quantidade de caracteres: ", compr(texto))
   escreval("Em maiúsculas: ", maiusc(texto))
   escreval("Em minúsculas: ", minusc(texto))
   escreval("Posição de 'I': ", pos("I", texto))

fimalgoritmo